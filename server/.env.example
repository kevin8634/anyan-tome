# 复制成 server/.env 再填。.env 不要提交到 Git
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
BASE_URL=https://你的域名
# 至少 32 位随机串，可用：openssl rand -base64 48
SECRET=
# 爱发电开发者后台 https://afdian.com/dashboard/dev
AFDIAN_USER_ID=
AFDIAN_TOKEN=
# 三个方案的 plan_id（在爱发电建好方案后，从方案链接里复制）
AFDIAN_PLAN_SINGLE=
AFDIAN_PLAN_FULL=
AFDIAN_PLAN_MENTOR=
# 价格以这里为准，必须和爱发电方案价格一致。早鸟结束后改成 299.00
PRICE_SINGLE=99.00
PRICE_FULL=199.00
PRICE_MENTOR=299.00
MAX_DEVICES=2
# 微信收款码（个人码，没有到账通知，要人工确认）。1 开 0 关；图片放在 static/img/
WECHAT_PAY=1
WECHAT_QR=/img/wechat-pay.webp
WECHAT_NAME=王磊-锐特 Rhett·AI 工坊
# 能打开 /admin/ 确认到账的账号（先在站上注册），多个用逗号隔开
ADMIN_EMAILS=
